# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TOMTOM_API_KEY: Optional TomTom Traffic API key for live flow & incident metrics.
# If omitted or unconfigured, the system automatically uses real-time Open-Meteo & OSRM routing metrics.
TOMTOM_API_KEY=""

# OPENWEATHER_API_KEY: Optional OpenWeatherMap API key.
# If omitted, Open-Meteo live API (no key required) is automatically utilized with real live atmospheric conditions.
OPENWEATHER_API_KEY=""
